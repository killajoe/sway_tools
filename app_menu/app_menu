#!/usr/bin/env bash

# app_menu (Rofi)
# A customized, balanced 4-column application menu configuration for Rofi, designed for Sway.

print_help() {
    cat << 'EOF'
app_menu (Rofi)
----------------
Usage: app_menu [MODE] [CONFIG]

Arguments:

  MODE        Rofi mode to launch (default: drun)
              Examples: drun, window, run, filebrowser

  CONFIG      Name of the config file without extension,
              searched in /usr/share/sway_tools/rofi/
              or ~/.config/rofi/ (default: rofidmenu)

Options:

  -h, --help  Display this help message and exit
EOF
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    print_help
    exit 0
fi

MODE="${1:-drun}"
CONFIG="${2:-rofidmenu}"

USER_CONFIG="$HOME/.config/rofi/${CONFIG}.rasi"
DEFAULT_CONFIG="/usr/share/sway_tools/rofi/${CONFIG}.rasi"

if [ -f "$USER_CONFIG" ]; then
    ROFI_CONFIG="$USER_CONFIG"
else
    ROFI_CONFIG="$DEFAULT_CONFIG"
fi

exec rofi -show "$MODE" -config "$ROFI_CONFIG"
