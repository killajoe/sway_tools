#!/usr/bin/env bash

# app_menu (Rofi)
# A customized, balanced 4-column application menu configuration for Rofi, designed for Sway.

print_help() {
    echo "app_menu (Rofi)"
    echo "----------------"
    echo "Usage: app_menu [MODE] [CONFIG]"
    echo ""
    echo "Arguments:"
    echo "  MODE         Rofi mode to launch (default: drun)"
    echo "               Examples: drun, window, run, filebrowser"
    echo "  CONFIG       Name of the config file without extension"
    echo "               searched in /usr/share/sway_tools/rofi/"
    echo "               or ~/.config/rofi/ (default: rofidmenu)"
    echo ""
    echo "Options:"
    echo "  -h, --help   Display this help message and exit"
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    print_help
    exit 0
fi

MODE="${1:-drun}"
CONFIG="${2:-rofidmenu}"

USER_CONFIG="$HOME/.config/rofi/${CONFIG}.rasi"
DEFAULT_CONFIG="/usr/share/sway_tools/rofi/${CONFIG}.rasi"

if [ -f "$USER_CONFIG" ]; then
    ROFI_CONFIG="$USER_CONFIG"
else
    ROFI_CONFIG="$DEFAULT_CONFIG"
fi

exec rofi -show "$MODE" -config "$ROFI_CONFIG"
